<%- layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= token %>";
  const coordinates = <%- JSON.stringify(list.geometry.coordinates) %>;
</script>

<style>
  .user-icon {
    width: 3rem;
    background-color: #8080807d;
    height: 3rem;
    display: inline-block;
    /* background-image: url("/css/user.jpg"); */
    background-size: 4rem;
    background-position: center;
    border-radius: 50%;
    overflow: hidden;
  }

  .user-icon img {
      width: 100%;
      font-size: 0.5rem;
      aspect-ratio: 1 / 1;
  }

  .user {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-size: cover;
    padding: 0 !important;
  }

  .rev-user {
    display: flex;
    align-items: center;
  }
</style>

<body>
  <div class="container-fluid show-listing pt-3 pb-3">
    <div class="user  col-md-11 mb-3">
        <span class="user-icon">
          <img src="<%= list.owner.profilePic %>" alt="">
        </span>
        <p style="font-weight: 500; margin: 0;">Hosted By&nbsp;<%= list.owner.username %>
        </p>
      </div>
    <div class=" offset-md-1" id="listing">
      
      <h1 class="col-md-11 mt-3 pb-2 show-title">
        <%=list.title%>
      </h1>
      <div class=" col-md-11 show-img">
        <img src="<%=list.image.url%>" alt="<%=list.image.filename%>" />
      </div>
      <div class="col-md-11 mt-3 show-des">
        <p>
          <%=list.description%>
        </p>
        <p>
          <i class="fa-solid fa-location-dot"></i>&nbsp;&nbsp;<%=list.location%>, <%=list.country%>
        </p>
      </div>
      <div class="row col-md-11 mb-2 show-price">
        <b>&#8377; <%=list.price.toLocaleString("en-IN")%> / night</b>
      </div>
      <% if(currUser && currUser._id.equals(list.owner._id) ) { %>
        <div class="row col-md-11">
          <div class="btns mb-3">
            <form class="btn-group" method="post" action="/listing/<%=list._id%>?_method=DELETE">
              <a type="button" href="/listing/<%=list._id%>/edit" class="btn btn-outline-danger"><i
                  class="fa-solid fa-pen-to-square"></i></a>
              <button class="btn btn-outline-danger">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </div>
        <% } %>
    </div>
  </div>

  <% if (list.reviews.length> 0) { %>
    <div class="line"></div>
    <div class="container-fluid review-box mb-4" id="review">
      <h2 class="mb-3 review-h2">Reviews</h2>
      <div class="review-row">
        <% for (let review of list.reviews) { %>
          <!-- <div class="review-container"> -->
          <div class="card review-card">
            <div class="card-body">
              <% if(currUser && currUser._id.equals(review.author._id)) { %>
                <form action="/listing/<%=list._id%>/review/<%=review._id%>?_method=DELETE" method="post"
                  class="review-del-form">
                  <button class="btn">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </form>
                <% } %>
                  <div class="card-title review-user">
                    <span class="user-icon">
                      <img src="<%= review.author.profilePic %>" alt="<%= review.author.username %>">
                    </span>
                    <p style="margin: 0;">
                      <%=review.author.username%>
                        <p>
                  </div>
                  <p class="card-text rev-user" style="font-size: 0.85rem; margin: 0;">
                    <span style="font-size: 0.5rem;" class="rating-star">
                      <!-- <p class="starability-result" data-rating="<%= review.rating %>"></p> -->
                      <% for(let i=0; i < review.rating; i++) { %>
                        <i class="fa-solid fa-star"></i>
                        <% } %>
                    </span>
                    <span style="padding: 0 5px; font-size:1rem;">·</span>
                    <span style="font-weight: 500;">
                      <%= review.createdAt.toLocaleDateString("en-US",{ year: "numeric" , month: "long" , day: "numeric"
                        }) , // hour: "2-digit" , // minute: "2-digit" }) %>
                    </span>
                  </p>
                  <div class="comment-line line"></div>
                  <div class="comment mb-2" style="overflow: auto;">
                    <p class="card-text comment">
                      <%= review.comment %>
                    </p>
                  </div>
            </div>
          </div>
          <% } %>
      </div>
    </div>
    <% } %>
      <div class="line"></div>
      <div class="col-md-10 offset-md-1 mb-3 pt-3 pb-3 map-section">
        <div class="map-info">
          <h2>Where you’ll be</h2>
          <p><i class="fa-solid fa-location-dot"></i>&nbsp;&nbsp;<%=list.location%>, <%=list.country%></p>
        </div>

        <div id="map"></div>
      </div>

      <% if(currUser) { %>
        <div class="line"></div>
        <div class="container-fluid p-3">
          <form action="/listing/<%=list.id%>/review" method="post" class="comment-form  needs-validation"
            novalidate>
            <div class=" mb-2">
              <h2 class="ps-0 mb-3 rat-h2"><label for="rating" class="form-lable">Rating</label></h2>
              <fieldset class="starability-coinFlip pt-2">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                  aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-lable"><b>Comment</b></label>
              <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"
                required></textarea>
              <div class="invalid-feedback">write a valid comment</div>
            </div>
            <div class="mb-3 review-btn-div">
              <button class="btn btn-outline-dark review-btn">
                Post <i class="fas fa-paper-plane"></i>
              </button>
            </div>
          </form>
        </div>
        <% } %>

          <script src="/js/map.js"></script>
</body>