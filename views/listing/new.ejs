<%- layout("/layouts/boilerplate") %>


<body>
    <div class="container-fluid" >
        <h3 class="offset-md-2 mt-3 mb-3">Add Listing</h3>
        <div class="col-md-8 offset-md-2 new-form">
            <form method="post" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-lable">Title</label>
                    <input type="text" name="listing[title]" id="title" placeholder="Give title" class="form-control"
                        required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">invalid field entry</div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-lable">Description</label>
                    <textarea name="listing[description]" id="description" rows="5" class="form-control"
                        required></textarea>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">invalid field entry</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-lable">Price</label>
                        <input type="number" name="listing[price]" id="price" placeholder="5000" class="form-control"
                            required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">invalid field entry</div>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-lable">Country</label>
                        <input type="text" name="listing[country]" id="country" placeholder="India" class="form-control"
                            required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">invalid field entry</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-lable">Location</label>
                    <input type="text" name="listing[location]" id="location" placeholder="Amritsar, Goa"
                        class="form-control" required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">invalid field entry</div>
                </div>
                <div class="mb-2">
                    <label for="Image" class="form-lable">Upload Images</label>
                    <input type="file" name="listing[image]" id="Image" placeholder="Image" class="form-control" required>
                    <div class="invalid-feedback">Provide listing image</div>
                </div>
                <div class="submit mb-3">
                    <button class="btn btn-danger mt-4">Submit</button>
                </div>
            </form>
        </div>
    </div>
</body>