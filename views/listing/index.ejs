<%- layout("/layouts/boilerplate") %>

<!-- Page-specific styling (for filters, tax toggle, and layout) -->
<style>
    #filters {
        display: flex;
        gap: 2rem;
        align-items: center;
        overflow: auto;
        width: fit-content;
        max-width: 73%;
    }

    .filter {
        text-align: center;
        margin-top: 2rem;
        opacity: 0.7;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        font-size: 0.8rem;
    }

    .tax-toggle {
        border: 1px solid rgb(162, 162, 162);
        height: 3.5rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        border-radius: 2rem;
        align-items: center;
    }

    /* Hidden tax info (toggled via JS) */
    .tax-info {
        display: none;
    }

    .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 2.5rem;
    }

    /* Custom toggle switch styling */
    .form-check-input {
        height: 1.5rem;
        width: 3rem !important;
    }
    .form-check-input:checked {
        background-color: #ff0000;
        border-color: #ff0000;
    }
    .form-check-input:focus {
        border-color: #fe8686;
        outline: 0;
        box-shadow: 0 0 0 .25rem rgba(253, 13, 13, 0.25);
    }

    /* Reset Bootstrap focus style on toggle switch */
    .form-switch .form-check-input:focus {
        border-color: rgba(0, 0, 0, 0.25);
        outline: 0;
        box-shadow: 0 0 0 0 rgb(0, 0, 0);
        background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba(187, 187, 187)'/></svg>");
    }

    .form-check-label {
        display: block;
    }

    .form-check {
        width: 12rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-check, 
    .form-switch {
        padding-left: 0;
    }
</style>

<!-- Top bar: category filters + tax toggle -->
<div class="top-bar">

    <!-- Filter section -->
    <div id="filters">
        <!-- Example filter item -->
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-building"></i></div>
            <p>Appartments</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Highlands</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Coastal</p>
        </div>
        <!-- (Some filters repeated for layout purposes) -->
        <div class="filter">
            <div><i class="fa-solid fa-building"></i></div>
            <p>Appartments</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-building"></i></div>
            <p>Appartments</p>
        </div>
    </div>

    <!-- Tax toggle switch -->
    <div class="tax-toggle">
        <div class="form-check form-switch">
            <label class="form-check-label" for="switchCheckDefault">Display Taxes</label>
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        </div>
    </div>
</div>

<!-- Listings Section -->
<div class="container-fluid main-box mt-3 mb-3">
    <div class="row row-cols-2 row-cols-lg-5 row-cols-md-4 row-cols-sm-2 card-container">

        <!-- Loop through all listings -->
        <% for(let list of allListings) { %>
            <a href="/listing/<%= list._id %>" class="view">
                <div class="card col">

                    <!-- Listing Image -->
                    <img src="<%= list.image.url %>" 
                         class="card-img-top" 
                         alt="<%= list.image.filename %>">

                    <div class="card-body">
                        <!-- Listing Title -->
                        <h5 class="card-title"><%= list.title %></h5>

                        <!-- Price per night -->
                        <p class="card-text">
                            &#8377; <%= list.price.toLocaleString("en-IN") %> / night
                            <!-- Hidden tax info (toggleable) -->
                            <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</div>

<!-- Tax toggle script -->
<script>
    let togBtn = document.getElementById("switchCheckDefault");

    togBtn.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");

        for (info of taxInfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline";  // Show tax info
            } else {
                info.style.display = "none";    // Hide tax info
            }
        }
    });
</script>


























